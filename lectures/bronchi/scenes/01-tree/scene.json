 "narration": [
  {
   "id": "n1",
   "text": "Якщо доросла людина вдихне горошину, вона найчастіше опиниться в правій легені. [[q]]Чому саме в правій?"
  },
  {
   "id": "n2",
   "text": "Ось дихальні шляхи спереду. Згори — [[tr]]трахея, обабіч неї — [[lr]]права і [[ll]]ліва легені.",
   "gap": 0.8
  },
  {
   "id": "n3",
   "text": "Унизу, на рівні четвертого–п'ятого грудних хребців, [[bif]]трахея ділиться на два головні бронхи.",
   "gap": 0.7
  },
  {
   "id": "n4",
   "text": "Правий головний бронх коротший, ширший і йде крутіше: він [[a25]]відхиляється від осі трахеї лише градусів на двадцять п'ять."
  },
  {
   "id": "n5",
   "text": "Лівий — довший і вужчий, і відходить убік під більшим кутом, [[a45]]близько сорока п'яти градусів."
  },
  {
   "id": "n6",
   "text": "Тож правий бронх майже продовжує трахею."
  },
  {
   "id": "n7",
   "text": "Тому стороннє тіло йде шляхом найменшого опору — [[d]]прямо вниз, у правий головний бронх.",
   "gap": 0.8
  },
  {
   "id": "n8",
   "text": "Зупиніться на мить. Де ви шукатимете стороннє тіло насамперед?",
   "gap": 0.8
  },
  {
   "id": "n9",
   "text": "У правому головному бронху.",
   "gap": 0.6
  }
 ],
